Qt*-linux*.tar.*

# ------------------------------------------------------------------------------
# Local Development Tools
# ------------------------------------------------------------------------------

# AI Assistants
.claude/
.gemini/
.geminiignore
.cursorignore

# Python tooling caches
.ruff_cache/
.pytest_cache/
.import_linter_cache/
.venv/
.tmp/codex/
/Ultralytics/

# Vale prose linter (downloaded via `vale sync`)
.github/styles/

# direnv / version managers
.envrc
.direnv/
.tool-versions
.python-version
!tools/.python-version

# Retired initialized submodule retained for previous builds
/src/FirmwarePlugin/APM/ArduPilot-Parameter-Repository/

# Debug candidate source tooling and documentation are not build outputs.
!tools/debug/
!tools/debug/*.ps1
!docs/debug/
!docs/debug/*.md
